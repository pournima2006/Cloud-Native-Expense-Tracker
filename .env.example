# ===================================================
# EXPENSE TRACKER MASTER ENVIRONMENT CONFIGURATION
# ===================================================

# ---------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (/backend/.env)
# ---------------------------------------------------
PORT=3000
NODE_ENV=development

# MySQL / AWS RDS Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=expense_tracker

# Express Session Security
SESSION_SECRET=expense_tracker_secure_session_secret_2026

# CORS Security
CORS_ORIGIN=http://localhost:5173

# Email / SMTP Service
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=reports@expensetracker.com

# Gemini OCR / AI Key
GEMINI_API_KEY=

# AWS S3 Storage Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ---------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (/frontend/.env)
# ---------------------------------------------------
# API Base Endpoint (Leave empty for same-domain proxy in dev, or set to http://localhost:5000/api)
VITE_API_URL=

